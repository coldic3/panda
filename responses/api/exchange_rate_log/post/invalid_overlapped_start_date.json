{
  "@context": "/contexts/ConstraintViolation",
  "@type": "ConstraintViolation",
  "@id": "/validation_errors/@uuid@",
  "status": 422,
  "detail": "@string@",
  "type": "/validation_errors/@uuid@",
  "title": "An error occurred",
  "description": "@string@",
  "violations": [
    {
      "propertyPath": "startedAt",
      "message": "The \"2023-07-17 01:00:00\" datetime cannot be overlapped with existing ExchangeRateLog identified by \"@uuid@\".",
      "code": "@uuid@"
    }
  ]
}

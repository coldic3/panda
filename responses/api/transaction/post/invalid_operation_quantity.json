{
  "@context": "/contexts/ConstraintViolation",
  "@type": "ConstraintViolation",
  "@id": "/validation_errors/@string@",
  "status": 422,
  "detail": "@string@",
  "type": "/validation_errors/@string@",
  "title": "An error occurred",
  "description": "@string@",
  "violations": [
    {
      "propertyPath": "fromOperation.quantity",
      "message": "This value should be 1 or more.",
      "code": "@uuid@"
    },
    {
      "propertyPath": "toOperation.quantity",
      "message": "This value should be 1 or more.",
      "code": "@uuid@"
    },
    {
      "propertyPath": "adjustmentOperations[0].quantity",
      "message": "This value should be 1 or more.",
      "code": "@uuid@"
    }
  ]
}
